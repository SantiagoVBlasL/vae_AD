{
  "run_name": "adni_expanded_v4_beta25_static3",
  "description": "BSPC 2026 ADNI expanded v4 retraining: v3 + Martin Philips7, beta=2.5, static 3-channel input. Identical hyperparameters to v3.",
  "python_executable": "python3",
  "paths": {
    "training_script": "scripts/run_vae_clf_ad_inference.py",
    "expanded_dataset_dir": "data/revision_bspc_2026/adni_expanded_v4_all_available",
    "global_tensor_path": "data/revision_bspc_2026/adni_expanded_v4_all_available/GLOBAL_TENSOR_ADNI_expanded_v4_all_available.npz",
    "metadata_path": "data/revision_bspc_2026/adni_expanded_v4_all_available/subject_metadata_adni_expanded_v4_all_available.csv",
    "output_dir": "results/revision_bspc_2026/adni_expanded_v4_beta25_static3",
    "v3_model_dir": "results/revision_bspc_2026/adni_expanded_v3_beta25_static3"
  },
  "parameters": {
    "channels_to_use": [1, 0, 2],
    "classifier_types": ["logreg", "svm"],
    "classifier_calibrate": true,
    "classifier_use_class_weight": true,
    "gridsearch_scoring": "roc_auc",
    "outer_folds": 5,
    "inner_folds": 5,
    "repeated_outer_folds_n_repeats": 1,
    "epochs_vae": 2560,
    "vae_val_split_ratio": 0.2,
    "early_stopping_patience_vae": 240,
    "cyclical_beta_n_cycles": 32,
    "beta_vae": 2.5,
    "dropout_rate_vae": 0.15,
    "latent_dim": 256,
    "batch_size": 64,
    "lr_scheduler_type": "cosine_warm",
    "lr_scheduler_T0": 80,
    "lr_scheduler_eta_min": 5e-7,
    "weight_decay_vae": 5e-7,
    "n_jobs_gridsearch": 8,
    "metadata_features": ["Age", "Sex"],
    "save_fold_artefacts": true,
    "save_vae_training_history": true,
    "qc_analyze_distributions": true,
    "qc_check_scanner_leakage": true,
    "qc_rate_distortion": true,
    "qc_latent_information": true,
    "seed": 42
  }
}
